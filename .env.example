PORT=8080
LOG_LEVEL=info

UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_API_KEY=your_groq_api_key_here
UPSTREAM_PROVIDER=groq

FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_API_KEY=your_gemini_api_key_here
FALLBACK_MODEL=gemini-1.5-flash
FALLBACK_PROVIDER=gemini

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_real_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_SSLMODE=disable

DATABASE_URL=postgres://postgres:your_real_postgres_password@localhost:5432/postgres?sslmode=disable

# HTTP Server Timeouts
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=30s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s
